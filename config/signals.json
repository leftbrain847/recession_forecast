{
  "sources": {
    "T10Y3M": {
      "provider": "fred",
      "frequency": "daily",
      "max_stale_days": 10,
      "attribution": "FRED / Federal Reserve Board"
    },
    "SAHMREALTIME": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 75,
      "attribution": "FRED / Claudia Sahm"
    },
    "USREC": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 75,
      "attribution": "FRED / NBER"
    },
    "GACDFSA066MSFRBPHI": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 75,
      "attribution": "FRED / Federal Reserve Bank of Philadelphia"
    },
    "GACDISA066MSFRBNY": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 75,
      "attribution": "FRED / Federal Reserve Bank of New York"
    },
    "BACTSAMFRBDAL": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 75,
      "attribution": "FRED / Federal Reserve Bank of Dallas"
    },
    "DRTSCILM": {
      "provider": "fred",
      "frequency": "quarterly",
      "max_stale_days": 200,
      "attribution": "FRED / Federal Reserve Board (SLOOS)",
      "start": "1990-01-01"
    },
    "PERMIT": {
      "provider": "fred",
      "frequency": "monthly",
      "max_stale_days": 100,
      "attribution": "FRED / U.S. Census Bureau"
    },
    "EBP": {
      "provider": "csv",
      "url": "https://www.federalreserve.gov/econres/notes/feds-notes/ebp_csv.csv",
      "date_column": "date",
      "value_column": "ebp",
      "expected_columns": [
        "date",
        "gz_spread",
        "ebp",
        "est_prob"
      ],
      "frequency": "monthly",
      "max_stale_days": 100,
      "attribution": "Federal Reserve Board (excess bond premium, Gilchrist-Zakrajšek)"
    }
  },
  "fred": {
    "api_url": "https://api.stlouisfed.org/fred/series/observations",
    "api_key_env": "FRED_API_KEY",
    "raw_dir_env": "RF_RAW_DIR",
    "min_rows": 12,
    "timeout_seconds": 60
  },
  "signals": {
    "yield_curve": {
      "label": "Yield curve (10y - 3m)",
      "role": "prong",
      "enabled": true,
      "sources": [
        "T10Y3M"
      ],
      "transform": "monthly_mean",
      "threshold": {
        "op": "<",
        "value": 0
      },
      "persistence_months": 1,
      "uninverted_lookback_months": 24,
      "units": "pp",
      "short_label": "Yield curve",
      "plain": "Inverted when 10-year rates fall below 3-month rates",
      "trigger_text": "below 0"
    },
    "unemployment": {
      "label": "Sahm rule (real-time)",
      "role": "prong",
      "enabled": true,
      "sources": [
        "SAHMREALTIME"
      ],
      "transform": "level",
      "threshold": {
        "op": ">=",
        "value": 0.5
      },
      "persistence_months": 1,
      "units": "pp",
      "short_label": "Unemployment (Sahm rule)",
      "plain": "Jobless rate up 0.5 pt from its 12-month low",
      "trigger_text": "at or above 0.5"
    },
    "manufacturing": {
      "label": "Regional Fed manufacturing",
      "role": "prong",
      "enabled": true,
      "sources": [
        "GACDFSA066MSFRBPHI",
        "GACDISA066MSFRBNY",
        "BACTSAMFRBDAL"
      ],
      "transform": "mean_available_then_ma",
      "ma_months": 3,
      "philly_only_before": "2001-01",
      "threshold": {
        "op": "<",
        "value": 0
      },
      "persistence_months": 6,
      "units": "index, 3-mo avg",
      "short_label": "Factories (regional Fed surveys)",
      "plain": "Below 0 means more factories shrinking than growing, for 6+ months",
      "trigger_text": "below 0 for 6+ months"
    },
    "credit": {
      "label": "Credit (EBP or bank tightening)",
      "role": "prong",
      "enabled": true,
      "sources": [
        "EBP",
        "DRTSCILM"
      ],
      "transform": "components",
      "combine": "any",
      "components": [
        {
          "source": "EBP",
          "label": "Excess bond premium",
          "op": ">",
          "value": 0.5
        },
        {
          "source": "DRTSCILM",
          "label": "Banks tightening C&I (net %)",
          "op": ">=",
          "value": 25,
          "forward_fill_months": 3
        }
      ],
      "persistence_months": 1,
      "units": "pp",
      "short_label": "Credit stress",
      "plain": "Bond investors demanding extra risk pay, or banks tightening loans",
      "trigger_text": "bond premium above 0.5 or banks tightening at or above 25%"
    },
    "housing": {
      "label": "Building permits YoY",
      "role": "watch",
      "enabled": true,
      "sources": [
        "PERMIT"
      ],
      "transform": "yoy_pct",
      "threshold": {
        "op": "<=",
        "value": -20
      },
      "persistence_months": 1,
      "units": "%",
      "short_label": "Building permits",
      "plain": "New permits vs a year earlier",
      "trigger_text": "down 20% or more"
    }
  },
  "backtest": {
    "window_months": 18,
    "include_start_month": false,
    "recession_source": "USREC",
    "n_of_prongs": [
      1,
      2,
      3,
      4
    ]
  },
  "output": {
    "path": "docs/data/signals.json",
    "chart_start": "1973-01",
    "timeline_start": "1959-01"
  },
  "stages": {
    "merge_gap_months": 3,
    "order": [
      "warning",
      "arriving",
      "confirmed"
    ],
    "definitions": {
      "warning": {
        "label": "Warning",
        "blurb": "Yield curve inverted now or within the past 24 months.",
        "all": [
          {
            "signal": "yield_curve",
            "lit_within_months": 24
          }
        ],
        "match_before_months": 0,
        "match_after_months": 24,
        "plain": "Recession risk is elevated: the yield curve has inverted.",
        "next_text": "Moves to Arriving if factories or credit start flashing."
      },
      "arriving": {
        "label": "Arriving",
        "blurb": "Warning is on and manufacturing or credit is lit.",
        "all": [
          {
            "stage": "warning"
          }
        ],
        "any": [
          {
            "signal": "manufacturing"
          },
          {
            "signal": "credit"
          }
        ],
        "match_before_months": 0,
        "match_after_months": 18,
        "plain": "A recession may be close: the yield curve warned and factories or credit are now flashing.",
        "next_text": "Moves to Confirmed if the Sahm rule triggers."
      },
      "confirmed": {
        "label": "Confirmed",
        "blurb": "Sahm rule lit (real-time unemployment).",
        "all": [
          {
            "signal": "unemployment"
          }
        ],
        "match_before_months": 12,
        "match_after_months": 12,
        "plain": "A recession has likely begun: unemployment is rising fast.",
        "next_text": ""
      }
    }
  }
}
